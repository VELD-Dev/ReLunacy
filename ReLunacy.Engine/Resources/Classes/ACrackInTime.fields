# A Crack in Time: what is known of the settings fields of each class - names, types, descriptions.
# Hand-editable; the editor's inspector reads it and can change it (Edit fields).
#
#   [offset, type] Field name = "description";           add ", runtime" for a field the game overwrites
#   types: u8 u16 u32 s32 float bool bool32 text  ref  Moby Path Volume Clue Controller Scent Area Pod
#          component(size)  or the name of an enum declared below
#   enum Name : u32 { Entry = 1; }     flags Name : u8 { Bit = 0x1; }
#   class 0xNUMBER Name : 0xPARENT { fields }           a class inherits its parents' fields

enum Axis : u32
{
    Axis0 = 0;
    Axis1 = 1;
    Axis2 = 2;
}

enum BarrierType : u16
{
    None = 0;
    Terachnos = 1;
    Tombli = 2;
    NefariousStation = 3;
}

enum Level : u32
{
    None = 0;
    GreatClockA = 1;
    ZolarForest = 2;
    SpaceSector1 = 3;
    GalactonShip = 4;
    GreatClockB = 5;
    SpaceSector2 = 6;
    Molonoth = 7;
    AxiomCity = 8;
    GreatClockC = 9;
    SpaceSector3 = 10;
    KrellCanyon = 11;
    AgorianArena = 12;
    Tombli = 13;
    GreatClockD = 14;
    SpaceSector4 = 15;
    ValkyrieFleet = 16;
    NefariousStation = 17;
    SpaceSector5 = 18;
    GimlickValley = 19;
    GreatClockE = 20;
    Museum = 21;
    FrontEnd = 22;
}

enum SpawnRule : u32
{
    Always = 0;
    FirstVisitOnly = 1;
    ReplayOnly = 2;
    GoneOnceBroken = 3;
    GoneOnceBrokenBackOnReplay = 4;
    Never = 5;
    FirstVisitUnlessBroken = 6;
    ReplayUnlessBroken = 7;
}

