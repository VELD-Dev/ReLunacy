class 0xE9 ScriptBaseElem
{
    size 0x3C;
    [0x4, ptr Element] Next = "The element that runs next; for a condition, the one taken when it is true.";
    [0x8, ptr Element] Else = "For a condition, the element taken when it is false.";
    [0xC, u32, runtime] Came from = "";
    [0x10, u32, runtime] Branch taken = "";
    [0x14, u32, runtime] Label = "";
    [0x18, u32, runtime] Field list = "";
    [0x30, u32, runtime] Class = "";
    [0x34, u32, runtime] Field count = "";
    [0x38, ScriptForce] Force = "Debug override: always take this branch.";
}

