# Fall of Man: settings fields of each placed class, found from the retail levels and game.elf.
# Same syntax as ACrackInTime.fields (see its header). Offsets are into the class data, which starts with the class number;
# parents come from the game's own class table. Fields some level sets are listed; unnamed ones are not yet traced.

enum CompareTest : u32
{
    Greater = 0;
    Less = 1;
    Near = 2;
}

enum NuggetOp : u32
{
    And = 0;
    AndNot = 1;
    Or = 2;
    OrNot = 3;
    Xor = 4;
    Xnor = 5;
}

enum ScriptArea : u32
{
    Volume = 0;
    Area = 1;
}

flags ScriptForce : u32
{
    True = 0x1;
    False = 0x2;
}

enum ScriptTarget : u32
{
    Moby = 0;
    Pod = 1;
}

enum ScriptWatch : u32
{
    Off = 0;
    TurnsTrue = 1;
    TurnsFalse = 2;
    Either = 3;
}

class 0x1 IGG_GameObjectUpdate
{
}

