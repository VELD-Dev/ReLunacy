<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>-->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- ProgramInfo.cs applies this attribute itself, from the same const the app and UpdateChecker
         read, so the version is written once. Without this the SDK emits its own copy from
         $(Version) into obj/*/ReLunacy.AssemblyInfo.cs and the two collide (CS0579). -->
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <!-- A level load decodes thousands of textures on every core at once, each allocating its pixels:
         the workstation collector serialises those threads, the server one gives each core its own heap
         (krell_canyon's texture decode 0.9 s -> 0.6 s, a creature_collector region 0.48 -> 0.23 s,
         dev/tools/decodeprobe). .NET 10 sizes the server heaps to the load (DATAS), so an idle editor
         does not hold one heap per core. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\logo.ico" />
    <Content Include="Assets\logo.svg" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Assets\ReLunacyCamera.obj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\ReLunacyCamera.obj</Link>
    </Content>
    <Content Include="Assets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="Assets\Icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Icons\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Locales/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Locales\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Code editor themes, shipped like Locales and LuaApi so they can be edited next to the exe. -->
  <ItemGroup>
    <Content Include="Themes/*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Lua API documentation, shipped the same way as Locales: versioned here, copied next to the
       executable, and editable there without a rebuild. Recursive, since it is one folder per game. -->
  <ItemGroup>
    <Content Include="LuaApi/**/*.lua;LuaApi/**/*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>LuaApi\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.ico" />
    <EmbeddedResource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.4.0-preview.1" />
    <PackageReference Include="NAudio.Flac" Version="1.0.5702.29018" />
    <PackageReference Include="NAudio.Flac.Unknown" Version="1.0.4" />
    <PackageReference Include="NAudio.Lame" Version="2.1.0" />
    <PackageReference Include="NAudio.Lame.CrossPlatform" Version="2.2.1" />
    <PackageReference Include="NAudio.SoundFile" Version="3.4.0-preview.1" />
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.10-prerelease" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.10-prerelease" />
    <PackageReference Include="Newtonsoft.Json" Version="14.0.1-beta2" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.6.0-alpha" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="NeoVeldrid" Version="1.2.1" />
    <PackageReference Include="NeoVeldrid.SPIRV" Version="1.2.1" />
    <PackageReference Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" Version="2.23.0" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
    <PackageReference Include="WindowsShortcutFactory" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReLunacy.Engine\ReLunacy.Engine.csproj" />
  </ItemGroup>

  <!-- Depends on the deleted UpdateChecker (GitHub-release auto-update check) - deferred,
       not core viewer functionality. -->
  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Fonts\" />
    <Folder Include="Core\MenuBar\" />
    <Folder Include="Locales\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Locales\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
