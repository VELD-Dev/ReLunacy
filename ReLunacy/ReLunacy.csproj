<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--<SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>-->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\logo.ico" />
    <Content Include="Shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Shaders\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Assets\Fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Fonts\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Locales/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Locales\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window creation and input. Came in transitively through Bliss until its host layer was
         replaced (see Utility/Host); referenced directly now. -->
    <PackageReference Include="SDL3-CS" Version="3.5.0-preview.20260213-150035" />
    <PackageReference Include="SDL3-CS.Native" Version="3.5.0-preview.20260205-174353" />
    <PackageReference Include="Hexa.NET.ImGui" Version="2.2.10-prerelease" />
    <PackageReference Include="Hexa.NET.ImGuizmo" Version="2.2.10-prerelease" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.5-beta1" />
    <PackageReference Include="NativeFileDialogSharp" Version="0.6.0-alpha" />
    <!-- PNG/JPEG/etc decode and encode. Same two libraries Bliss used underneath its own Image type,
         referenced directly now. -->
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageReference Include="Veldrith" Version="1.2.19" />
    <!-- GLSL to SPIR-V, for the ImGui shaders and the fullscreen blit. Came in through Bliss. -->
    <PackageReference Include="Veldrith.SPIRV" Version="1.2.19" />
    <PackageReference Include="Vortice.Vulkan" Version="3.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReLunacy.Engine\ReLunacy.Engine.csproj" />
  </ItemGroup>

  <!-- Depends on the deleted UpdateChecker (GitHub-release auto-update check) - deferred,
       not core viewer functionality. -->
  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Fonts\" />
    <Folder Include="Core\MenuBar\" />
    <Folder Include="Locales\" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Locales\en.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
